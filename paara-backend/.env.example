PORT=4000

# Vercel Blob
# BLOB_READ_WRITE_TOKEN=
# Optional only for Vercel OIDC auth. A read-write token carries its own store scope.
# BLOB_STORE_ID=

# Self-generated UPI QR
UPI_ID=your-upi-id@bank
UPI_PAYEE_NAME=Your Business Name

# Frontend URL (comma-separated list supported)
FRONTEND_URL=http://localhost:5173,https://paara.vercel.app

# Authentication
JWT_SECRET=change_this_to_a_long_random_secret
ADMIN_API_KEY=change_this_to_a_long_random_key

# WhatsApp
WHATSAPP_PHONE_NUMBER_ID=your_whatsapp_phone_number_id
WHATSAPP_BUSINESS_ACCOUNT_ID=your_whatsapp_business_account_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token

# Razorpay
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Email
EMAIL_USER=your_email@example.com
EMAIL_PASSWORD=your_email_password
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587